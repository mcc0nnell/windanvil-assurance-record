{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://windanvil.com/schemas/vivisection-assurance-record-v1.schema.json",
  "title": "WindAnvil Vivisection Assurance Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "generatedAt",
    "identity",
    "subject",
    "authority",
    "experiment",
    "receipts",
    "judgment",
    "verdict",
    "evidence",
    "digest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "windanvil.vivisection-assurance-record" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experimentId", "sessionId", "causalId"],
      "properties": {
        "experimentId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "causalId": { "type": "string", "minLength": 1 }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestId", "capability", "bundleId", "bundleSha256"],
      "properties": {
        "manifestId": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "bundleId": { "type": "integer", "minimum": 0 },
        "bundleSha256": { "$ref": "#/$defs/sha256hex" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityManifest", "vivisectionGrant"],
      "properties": {
        "capabilityManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "digest"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/digest" }
          }
        },
        "vivisectionGrant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "digest",
            "bladeId",
            "keyId",
            "authorizationEpoch",
            "notAfterUnix",
            "allowedEffects"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/digest" },
            "bladeId": { "type": "string", "minLength": 1 },
            "keyId": { "type": "string", "minLength": 1 },
            "authorizationEpoch": { "type": "integer", "minimum": 1 },
            "notAfterUnix": { "type": "integer", "minimum": 1 },
            "allowedEffects": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probeName",
        "probeVersion",
        "probeDescriptorSha256",
        "inputSha256",
        "requestSha256",
        "authorizationIdSha256",
        "terminal",
        "requestedEffects",
        "exercisedEffects"
      ],
      "properties": {
        "probeName": { "type": "string", "minLength": 1 },
        "probeVersion": { "type": "string", "minLength": 1 },
        "probeDescriptorSha256": { "$ref": "#/$defs/sha256hex" },
        "inputSha256": { "$ref": "#/$defs/sha256hex" },
        "requestSha256": { "$ref": "#/$defs/sha256hex" },
        "authorizationIdSha256": { "$ref": "#/$defs/sha256hex" },
        "outputSha256": { "$ref": "#/$defs/sha256hex" },
        "terminal": { "enum": ["COMPLETED", "FAILED"] },
        "requestedEffects": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "exercisedEffects": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "terminal": { "const": "COMPLETED" } }, "required": ["terminal"] },
          "then": { "required": ["outputSha256"] }
        },
        {
          "if": { "properties": { "terminal": { "const": "FAILED" } }, "required": ["terminal"] },
          "then": { "not": { "required": ["outputSha256"] } }
        }
      ]
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opened",
        "grantVerified",
        "grantAdmitted",
        "grantBound",
        "grantAuthorized",
        "probeAuthorized",
        "authorizationConsumed",
        "terminal",
        "closed"
      ],
      "properties": {
        "opened": { "$ref": "#/$defs/digest" },
        "grantVerified": { "$ref": "#/$defs/digest" },
        "grantAdmitted": { "$ref": "#/$defs/digest" },
        "grantBound": { "$ref": "#/$defs/digest" },
        "grantAuthorized": { "$ref": "#/$defs/digest" },
        "probeAuthorized": { "$ref": "#/$defs/digest" },
        "authorizationConsumed": { "$ref": "#/$defs/digest" },
        "terminal": { "$ref": "#/$defs/digest" },
        "closed": { "$ref": "#/$defs/digest" }
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "binding", "evidence", "effects", "causality", "reconstructability", "replay"],
      "properties": {
        "authority": { "enum": ["VALID", "INVALID", "NOT_EVALUATED"] },
        "binding": { "enum": ["VALID", "INVALID"] },
        "evidence": { "enum": ["COMPLETE", "INCOMPLETE"] },
        "effects": { "enum": ["CONFORMANT", "VIOLATION", "NOT_APPLICABLE"] },
        "causality": { "enum": ["COMPLETE", "PARTIAL", "BROKEN", "NOT_EVALUATED"] },
        "reconstructability": { "enum": ["YES", "NO", "BLOCKED"] },
        "replay": { "enum": ["MATCH", "DIVERGED", "NOT_RUN", "BLOCKED"] }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "reason"],
      "properties": {
        "value": { "enum": ["PASS", "FAIL", "BLOCKED"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationDigests", "artifactDigests"],
      "properties": {
        "observationDigests": {
          "type": "array",
          "items": { "$ref": "#/$defs/digest" },
          "uniqueItems": true
        },
        "artifactDigests": {
          "type": "array",
          "items": { "$ref": "#/$defs/digest" },
          "uniqueItems": true
        }
      }
    },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
